+++ b/tests/mirasimQuota.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, test } from 'bun:test';
+import type { TFunction } from 'i18next';
+import {
+  buildMirasimQuotaWindows,
+  normalizeMirasimUtilization,
+} from '@/features/quota/providers/mirasim/data';
+
+const t = ((key: string) => key) as TFunction;
+
+describe('Mirasim quota adapter', () => {
+  test('normalizes ratio, percent, and percent-sign utilization values', () => {
+    expect(normalizeMirasimUtilization('0.25')).toBe(25);
+    expect(normalizeMirasimUtilization('25')).toBe(25);
+    expect(normalizeMirasimUtilization('25%')).toBe(25);
+    expect(normalizeMirasimUtilization('invalid')).toBeNull();
+    expect(normalizeMirasimUtilization('101')).toBeNull();
+  });
+
+  test('builds five-hour and seven-day windows from the plugin response', () => {
+    const fiveHourReset = '2026-09-01T09:00:00Z';
+    const sevenDayResetSeconds = 1_788_431_522;
+    expect(
+      buildMirasimQuotaWindows(
+        {
+          quota: {
+            available: true,
+            five_hour: { utilization: '0.25', reset_at: fiveHourReset },
+            seven_day: { utilization: '50%', reset: String(sevenDayResetSeconds) },
+          },
+        },
+        t
+      )
+    ).toEqual([
+      {
+        id: 'five-hour',
+        label: 'mirasim_quota.five_hour',
+        labelKey: 'mirasim_quota.five_hour',
+        usedPercent: 25,
+        resetLabel: new Date(fiveHourReset).toISOString(),
+        resetAtMs: Date.parse(fiveHourReset),
+        periodHours: 5,
+      },
+      {
+        id: 'seven-day',
+        label: 'mirasim_quota.seven_day',
+        labelKey: 'mirasim_quota.seven_day',
+        usedPercent: 50,
+        resetLabel: new Date(sevenDayResetSeconds * 1000).toISOString(),
+        resetAtMs: sevenDayResetSeconds * 1000,
+        periodHours: 168,
+      },
+    ]);
+  });
+
+  test('does not fabricate windows when the fresh response has no signals', () => {
+    expect(buildMirasimQuotaWindows({ quota: { available: false } }, t)).toEqual([]);
+  });
+});
