@@ -0,0 +1,130 @@
+import type { TFunction } from 'i18next';
+import type { AuthFileItem, MirasimQuotaState, MirasimQuotaWindow } from '@/types';
+import { apiClient } from '@/services/api';
+import { isDisabledAuthFile, isMirasimFile } from '@/utils/quota';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import type { QuotaProviderData } from '../types';
+
+interface MirasimQuotaWindowPayload {
+  utilization?: unknown;
+  reset?: unknown;
+  reset_at?: unknown;
+}
+
+export interface MirasimQuotaResponse {
+  model_count?: unknown;
+  quota?: {
+    available?: unknown;
+    observed_at?: unknown;
+    five_hour?: MirasimQuotaWindowPayload | null;
+    seven_day?: MirasimQuotaWindowPayload | null;
+  } | null;
+}
+
+export interface MirasimQuotaData {
+  windows: MirasimQuotaWindow[];
+  observedAt: string | null;
+  modelCount: number | null;
+}
+
+const normalizeText = (value: unknown): string =>
+  typeof value === 'string' ? value.trim() : value == null ? '' : String(value).trim();
+
+/** Mirasim's unified utilization headers are ratios; tolerate percent-form values too. */
+export const normalizeMirasimUtilization = (value: unknown): number | null => {
+  const text = normalizeText(value);
+  if (!text) return null;
+  const percentForm = text.endsWith('%');
+  const parsed = Number.parseFloat(percentForm ? text.slice(0, -1) : text);
+  if (!Number.isFinite(parsed) || parsed < 0) return null;
+  const percent = percentForm || parsed > 1 ? parsed : parsed * 100;
+  return percent <= 100 ? percent : null;
+};
+
+const resolveResetAtMs = (window: MirasimQuotaWindowPayload | null | undefined): number | null => {
+  if (!window) return null;
+  const resetAt = normalizeText(window.reset_at);
+  if (resetAt) {
+    const parsed = Date.parse(resetAt);
+    if (Number.isFinite(parsed)) return parsed;
+  }
+  const rawReset = normalizeText(window.reset);
+  if (!rawReset) return null;
+  const epoch = Number(rawReset);
+  if (!Number.isFinite(epoch) || epoch <= 0) return null;
+  return epoch < 1_000_000_000_000 ? epoch * 1000 : epoch;
+};
+
+const buildWindow = (
+  id: string,
+  labelKey: string,
+  periodHours: number,
+  window: MirasimQuotaWindowPayload | null | undefined,
+  t: TFunction
+): MirasimQuotaWindow | null => {
+  if (!window) return null;
+  const usedPercent = normalizeMirasimUtilization(window.utilization);
+  const resetAtMs = resolveResetAtMs(window);
+  if (usedPercent === null && resetAtMs === null) return null;
+  return {
+    id,
+    label: t(labelKey),
+    labelKey,
+    usedPercent,
+    resetLabel: resetAtMs === null ? '' : new Date(resetAtMs).toISOString(),
+    resetAtMs,
+    periodHours,
+  };
+};
+
+export const buildMirasimQuotaWindows = (
+  payload: MirasimQuotaResponse,
+  t: TFunction
+): MirasimQuotaWindow[] => {
+  const quota = payload.quota;
+  if (!quota || quota.available === false) return [];
+  return [
+    buildWindow('five-hour', 'mirasim_quota.five_hour', 5, quota.five_hour, t),
+    buildWindow('seven-day', 'mirasim_quota.seven_day', 168, quota.seven_day, t),
+  ].filter((window): window is MirasimQuotaWindow => window !== null);
+};
+
+const fetchMirasimQuota = async (
+  file: AuthFileItem,
+  t: TFunction
+): Promise<MirasimQuotaData> => {
+  const authIndex = normalizeAuthIndex(file['auth_index'] ?? file.authIndex);
+  if (!authIndex) throw new Error(t('mirasim_quota.missing_auth_index'));
+
+  const payload = await apiClient.get<MirasimQuotaResponse>('/mirasim/quota', {
+    params: { auth_index: authIndex },
+  });
+  const modelCount = Number(payload.model_count);
+  return {
+    windows: buildMirasimQuotaWindows(payload, t),
+    observedAt: normalizeText(payload.quota?.observed_at) || null,
+    modelCount: Number.isFinite(modelCount) && modelCount >= 0 ? modelCount : null,
+  };
+};
+
+export const MIRASIM_CONFIG: QuotaProviderData<MirasimQuotaState, MirasimQuotaData> = {
+  type: 'mirasim',
+  i18nPrefix: 'mirasim_quota',
+  filterFn: (file) => isMirasimFile(file) && !isDisabledAuthFile(file),
+  fetchQuota: fetchMirasimQuota,
+  storeSelector: (state) => state.mirasimQuota,
+  storeSetter: 'setMirasimQuota',
+  buildLoadingState: () => ({ status: 'loading', windows: [] }),
+  buildSuccessState: (data) => ({
+    status: 'success',
+    windows: data.windows,
+    observedAt: data.observedAt,
+    modelCount: data.modelCount,
+  }),
+  buildErrorState: (message, status) => ({
+    status: 'error',
+    windows: [],
+    error: message,
+    errorStatus: status,
+  }),
+};
